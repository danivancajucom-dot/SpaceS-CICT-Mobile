<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:orientation="vertical"
                android:padding="22dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Room Reassignment Request"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    android:textColor="@color/ink_900"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend_bold"/>

                <TextView
                    android:text="The Department Head has proposed a temporary room change for one of your classes."
                    android:textColor="@color/ink_500"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend_regular"/>

                <TextView android:text="Class Information" android:textStyle="bold" android:textColor="@color/ink_900" android:textSize="14sp" android:layout_marginTop="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/lexend_bold"/>
                <TextView android:id="@+id/infoText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/ink_700" android:textSize="13sp" android:lineSpacingExtra="4dp" android:fontFamily="@font/lexend_regular"/>

                <TextView android:text="Room Change" android:textStyle="bold" android:textColor="@color/ink_900" android:textSize="14sp" android:layout_marginTop="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/lexend_bold"/>

                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
                    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface_alt">
                        <TextView android:id="@+id/oldRoomText" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/ink_700" android:fontFamily="@font/lexend_bold"/>
                    </androidx.cardview.widget.CardView>
                    <TextView android:text="→" android:textSize="18sp" android:textColor="@color/ink_500" android:paddingHorizontal="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/brand_orange_soft">
                        <TextView android:id="@+id/newRoomText" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/brand_orange" android:fontFamily="@font/lexend_bold"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/brand_orange_soft"
                    android:padding="14dp"
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="This reassignment only applies to this scheduled class. Your regular weekly room assignment will remain unchanged."
                        android:textColor="@color/brand_orange_dark"
                        android:textSize="12.5sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend_regular"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/actionsLayout" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
                    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_marginEnd="8dp" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface_alt">
                        <Button android:id="@+id/rejectBtn" android:text="Reject" android:textAllCaps="false" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:textColor="@color/ink_700" android:fontFamily="@font/lexend_bold"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_marginStart="8dp" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/brand_orange">
                        <Button android:id="@+id/approveBtn" android:text="Accept Room" android:textAllCaps="false" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:textColor="#FFFFFF" android:fontFamily="@font/lexend_bold"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <TextView
                    android:id="@+id/expiredText"
                    android:text="This room reassignment has already ended. The response period is now closed."
                    android:textColor="@color/danger"
                    android:background="#FEF2F2"
                    android:padding="16dp"
                    android:layout_marginTop="24dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend_regular"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>