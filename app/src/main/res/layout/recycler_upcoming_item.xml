<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:padding="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/brand_orange_soft">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/dayLabel"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:textSize="10sp"
                    android:textColor="@color/brand_orange_dark"
                    android:fontFamily="@font/lexend_bold"/>
                <TextView
                    android:id="@+id/dateLabel"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/brand_orange_dark"
                    android:fontFamily="@font/lexend_bold"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/subjectLabel"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:textStyle="bold"
                android:textSize="14.5sp"
                android:textColor="@color/ink_900"
                android:fontFamily="@font/lexend_bold"/>

            <TextView
                android:id="@+id/roomTimeLabel"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:textColor="@color/ink_500"
                android:textSize="12.5sp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/lexend_regular"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>