<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TOP BAR: CATEGORY ICON + ROOM + SEVERITY + STATUS -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/issueIconCard"
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/brand_orange_soft">
                <ImageView
                    android:id="@+id/issueIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:src="@drawable/ic_electrical"
                    app:tint="@color/brand_orange"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_toEndOf="@id/issueIconCard"
                android:layout_toStartOf="@id/issueStatusContainer"
                android:layout_marginStart="14dp"
                android:layout_centerVertical="true"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/issueRoomText"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink_900"
                    android:fontFamily="@font/lexend_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/issueCategoryText"
                    android:textSize="12sp"
                    android:textColor="@color/ink_500"
                    android:fontFamily="@font/lexend_regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/issueStatusContainer"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/issueSeverityBadge"
                    android:text="URGENT"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_orange"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/brand_orange_border"
                    android:fontFamily="@font/lexend_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/issueStatusCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/brand_orange_soft">
                    <TextView
                        android:id="@+id/issueStatusText"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="PENDING"
                        android:textColor="@color/brand_orange"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/lexend_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </RelativeLayout>

        <!-- PHOTO / PLACEHOLDER -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/surface_alt">
            <ImageView
                android:id="@+id/issuePhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"/>
            <LinearLayout
                android:id="@+id/issuePhotoPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/ink_400"/>
                <TextView
                    android:text="No photo attached"
                    android:textSize="12sp"
                    android:textColor="@color/ink_400"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/lexend_regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </FrameLayout>

        <!-- DESCRIPTION -->
        <TextView
            android:id="@+id/issueDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textColor="@color/ink_700"
            android:textSize="13.5sp"
            android:fontFamily="@font/lexend_regular"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginHorizontal="16dp"/>

        <!-- BOTTOM INFO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_user"
                    app:tint="@color/ink_500"/>
                <TextView
                    android:id="@+id/issueReporterName"
                    android:textSize="11.5sp"
                    android:textColor="@color/ink_600"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/lexend_regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/ink_500"/>
                <TextView
                    android:id="@+id/issueTimeText"
                    android:textSize="11.5sp"
                    android:textColor="@color/ink_600"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/lexend_regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <TextView
                android:id="@+id/issueActivityLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/brand_orange_soft"
                android:padding="10dp"
                android:textColor="@color/brand_orange"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/lexend_bold"
                android:visibility="gone"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>