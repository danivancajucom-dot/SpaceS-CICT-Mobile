<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_bg">

    <FrameLayout
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="center"
        android:background="@drawable/dialog_icon_circle">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_edit"
            app:tint="@color/brand_orange"
            android:contentDescription="Edit icon" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Reset Password"
        android:textColor="@color/ink_900"
        android:textSize="19sp"
        android:textStyle="bold"
        android:fontFamily="@font/lexend_bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="We'll send a password reset link to your email."
        android:textColor="@color/ink_500"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:fontFamily="@font/lexend_regular"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Email Address"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="@color/ink_700"
        android:fontFamily="@font/lexend_bold"/>

    <EditText
        android:id="@+id/forgotEmailInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/input_field_bg"
        android:hint="Enter your email"
        android:inputType="textEmailAddress"
        android:padding="14dp"
        android:textColor="@color/ink_900"
        android:textColorHint="@color/ink_500"
        android:textSize="14sp"
        android:fontFamily="@font/lexend_regular"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/surface_alt">

        <TextView
            android:id="@+id/forgotCancelBtn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="@color/ink_700"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/lexend_bold"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/brand_orange">

        <TextView
            android:id="@+id/forgotSubmitBtn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Send Reset Link"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/lexend_bold"/>
    </androidx.cardview.widget.CardView>

</LinearLayout>