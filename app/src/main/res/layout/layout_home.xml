<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- GREETING ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/brand_orange_soft">

                <ImageView
                    android:id="@+id/homeProfileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/greetingName"
                    android:text="Loading..."
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/ink_900"
                    android:fontFamily="@font/lexend_bold"/>

                <TextView
                    android:id="@+id/greetingDateText"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:textColor="@color/ink_500"
                    android:textSize="13sp"
                    android:fontFamily="@font/lexend_regular"/>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/brand_orange">

                <Button
                    android:id="@+id/reserveButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:text="+ Reserve Room"
                    android:paddingHorizontal="16dp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/lexend_bold"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- TODAY'S SCHEDULE CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_marginTop="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Today's Schedule"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink_900"
                        android:fontFamily="@font/lexend_bold"/>

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="999dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/brand_orange_soft"
                        xmlns:app="http://schemas.android.com/apk/res-auto">

                        <TextView
                            android:id="@+id/seeAllText"
                            android:text="See All"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:textColor="@color/brand_orange"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/lexend_bold"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- SCHEDULE CARD (photo card, shown when today has an item) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/scheduleCard"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/room2"
                            android:background="@color/ink_300"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#59000000"/>

                        <TextView
                            android:id="@+id/scheduleStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="12dp"
                            android:background="@color/brand_orange"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="ONGOING"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/lexend_bold"/>

                        <LinearLayout
                            android:layout_gravity="bottom"
                            android:padding="16dp"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/scheduleRoomText"
                                android:layout_height="wrap_content"
                                android:layout_width="match_parent"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/lexend_bold"/>

                            <TextView
                                android:id="@+id/scheduleSubjectText"
                                android:layout_height="wrap_content"
                                android:layout_width="match_parent"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:alpha="0.9"
                                android:fontFamily="@font/lexend_regular"/>

                            <TextView
                                android:id="@+id/scheduleTimeText"
                                android:layout_height="wrap_content"
                                android:layout_width="match_parent"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:alpha="0.8"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/lexend_regular"/>
                        </LinearLayout>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- EMPTY STATE, matching web's gray placeholder -->
                <LinearLayout
                    android:id="@+id/noScheduleText"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/surface_alt"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:text="No classes scheduled for today."
                        android:textColor="@color/ink_900"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend_bold"/>

                    <TextView
                        android:text="Enjoy the free day, or check your upcoming classes below."
                        android:textColor="@color/ink_500"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend_regular"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- UPCOMING -->
        <TextView
            android:text="Upcoming Classes"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:textStyle="bold"
            android:textSize="17sp"
            android:layout_marginTop="24dp"
            android:textColor="@color/ink_900"
            android:fontFamily="@font/lexend_bold"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/upcomingRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/noUpcomingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:gravity="center"
            android:text="No upcoming classes found."
            android:textColor="@color/ink_500"
            android:visibility="gone"
            android:fontFamily="@font/lexend_regular"/>

    </LinearLayout>
</ScrollView>