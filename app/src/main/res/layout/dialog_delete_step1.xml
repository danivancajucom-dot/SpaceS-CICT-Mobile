<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxHeight="600dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/dialog_bg" android:padding="24dp">
        <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center" android:background="@drawable/circle_orange">
            <ImageView xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/ic_warning" app:tint="@color/danger"/>
        </FrameLayout>
        <TextView android:text="Delete Your Account?" android:textStyle="bold" android:textSize="18sp" android:textColor="@color/ink_900" android:gravity="center" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/lexend_bold"/>
        <TextView android:text="This is a permanent and irreversible action. Please read carefully before continuing." android:textColor="@color/ink_500" android:textSize="13sp" android:gravity="center" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/lexend_regular"/>
        <LinearLayout android:orientation="vertical" android:background="@color/danger_soft" android:padding="16dp" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="⚠ WHAT WILL BE LOST" android:textColor="@color/danger" android:textStyle="bold" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/lexend_bold"/>
            <TextView android:text="✕ All your class schedules and room assignments\n✕ All your reservations and pending requests\n✕ Your notification history and account data\n✕ Access to SpaceS CICT (you'll need a new invite)" android:textColor="@color/ink_900" android:textSize="13sp" android:lineSpacingExtra="6dp" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/lexend_regular"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:background="#FFFBEB" android:padding="14dp" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <CheckBox android:id="@+id/deleteUnderstandCheckbox" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="I understand this action is permanent and cannot be undone." android:textColor="@color/ink_900" android:textSize="12.5sp" android:layout_marginStart="8dp" android:layout_gravity="center_vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="@font/lexend_regular"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_marginEnd="8dp" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface_alt">
                <Button android:id="@+id/deleteCancelBtn" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="Cancel" android:textAllCaps="false" android:textColor="@color/ink_700" android:textStyle="bold" android:fontFamily="@font/lexend_bold"/>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_marginStart="8dp" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="#FCA5A5">
                <Button android:id="@+id/deleteContinueBtn" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="Continue" android:textAllCaps="false" android:textColor="#7F1D1D" android:textStyle="bold" android:enabled="false" android:fontFamily="@font/lexend_bold"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>