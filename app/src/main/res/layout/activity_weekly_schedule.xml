<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Weekly Schedule"
            android:textStyle="bold"
            android:textSize="25sp"
            android:textColor="@color/ink_900"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/lexend_bold"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#FFFFFF">

        <ImageView android:id="@+id/weekPrevBtn" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_back" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/weekLabelText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textStyle="bold" android:textSize="15sp" android:textColor="#111827" android:fontFamily="@font/lexend_bold"/>
        <ImageView android:id="@+id/weekNextBtn" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_back" android:scaleX="-1" android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <TextView android:id="@+id/termLabelText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingVertical="6dp" android:textColor="#6B7280" android:textSize="12sp" android:background="#FFFFFF" android:fontFamily="@font/lexend_regular"/>

    <!-- HEADER ROW: fixed left corner + scrollable day labels, synced with grid below -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF">

        <View
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="#F5F5F5"/>

        <HorizontalScrollView
            android:id="@+id/headerScroll"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/dayHeaderRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="8dp"/>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- CONTENT: time column (fixed) + grid (scrolls both directions) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:id="@+id/timeColumnScroll">

            <LinearLayout
                android:id="@+id/timeColumn"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"/>
        </ScrollView>

        <HorizontalScrollView
            android:id="@+id/contentHScroll"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">

            <ScrollView
                android:id="@+id/contentVScroll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/gridCanvas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"/>
            </ScrollView>
        </HorizontalScrollView>

    </LinearLayout>

</LinearLayout>