<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="24dp">

    <TextView
        android:text="Confirm Deletion"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/ink_900"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lexend_bold"/>

    <TextView
        android:text="Enter your password to permanently delete your account."
        android:textColor="@color/ink_500"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lexend_regular"/>

    <EditText
        android:id="@+id/deletePasswordInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/input_field_bg"
        android:hint="Enter your password"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:fontFamily="@font/lexend_regular"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Type DELETE MY ACCOUNT to confirm"
        android:textColor="@color/ink_900"
        android:textStyle="bold"
        android:textSize="12sp"
        android:fontFamily="@font/lexend_bold"/>

    <EditText
        android:id="@+id/deleteConfirmTextInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/input_field_bg"
        android:hint="DELETE MY ACCOUNT"
        android:inputType="textCapCharacters"
        android:paddingHorizontal="14dp"
        android:fontFamily="@font/lexend_regular"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_alt">

            <Button
                android:id="@+id/deleteStep2CancelBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/ink_700"
                android:textStyle="bold"
                android:fontFamily="@font/lexend_bold"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/danger">

            <Button
                android:id="@+id/deleteFinalBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="Delete Forever"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="@font/lexend_bold"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</LinearLayout>