<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F5F3">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:background="#FAF8F6"
        android:paddingHorizontal="22dp"
        android:paddingTop="20dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            app:tint="#111827"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notifications"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#111827"
            android:fontFamily="@font/lexend_bold"
            android:layout_centerInParent="true"/>

        <ImageView
            android:id="@+id/filterBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_filter"
            app:tint="#111827"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:background="#FAF8F6">

        <LinearLayout
            android:id="@+id/tabAll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tabAllText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#F97316"
                android:fontFamily="@font/lexend_regular"/>

            <View
                android:id="@+id/tabAllUnderline"
                android:layout_width="34dp"
                android:layout_height="3dp"
                android:layout_marginTop="16dp"
                android:background="#F97316"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabUnread"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="36dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tabUnreadText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unread"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#667085"
                android:fontFamily="@font/lexend_regular"/>

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/orange_dot"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tabArchivedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Archived"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#667085"
            android:layout_marginStart="36dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/lexend_regular"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EFE7DF"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/notificationRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:clipToPadding="false"/>

</LinearLayout>