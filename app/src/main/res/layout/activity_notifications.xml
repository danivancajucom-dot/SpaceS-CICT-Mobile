<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:background="@color/surface"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            app:tint="@color/ink_900"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notifications"
            android:textStyle="bold"
            android:textSize="19sp"
            android:textColor="@color/ink_900"
            android:fontFamily="@font/lexend_bold"
            android:layout_centerInParent="true"/>

        <ImageView
            android:id="@+id/filterBtn"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_filter"
            app:tint="@color/ink_900"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="@color/surface">

        <LinearLayout
            android:id="@+id/tabAll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tabAllText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/brand_orange"
                android:fontFamily="@font/lexend_bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabUnread"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="28dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tabUnreadText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unread"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/ink_500"
                android:fontFamily="@font/lexend_bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tabArchivedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Archived"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/ink_500"
            android:layout_marginStart="28dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/lexend_bold"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/notificationRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:clipToPadding="false"/>

</LinearLayout>