<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#F3F4F6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= HEADER ================= -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:paddingHorizontal="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <!-- BACK BUTTON -->
        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            android:layout_centerVertical="true"/>

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Reservation Request"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="#111827"
            android:layout_centerInParent="true"
            android:fontFamily="@font/lexend_bold"/>
    </RelativeLayout>

    <!-- ================= CONTENT ================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- DESCRIPTION -->
            <TextView
                android:text="Fill out the details below to reserve a classroom."
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/lexend_regular"/>

            <!-- COURSE -->
            <TextView
                android:text="Course Title"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:textColor="#111827"
                android:fontFamily="@font/lexend_bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_split"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/courseInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:padding="16dp"
                    android:hint="Enter course title"
                    android:textColor="#111827"
                    android:textColorHint="#6B7280"
                    android:fontFamily="@font/lexend_regular"/>

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/input_icon_bg"
                    android:padding="12dp"
                    android:src="@drawable/ic_laptop"/>
            </LinearLayout>

            <!-- DATE -->
            <TextView
                android:text="Select Date"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:textColor="#111827"
                android:fontFamily="@font/lexend_bold"/>

            <LinearLayout
                android:id="@+id/datePicker"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/input_split"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:text="Select Date"
                    android:textColor="#111827"
                    android:textColorHint="#6B7280"
                    android:fontFamily="@font/lexend_regular"/>

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/input_icon_bg"
                    android:padding="12dp"
                    android:src="@drawable/ic_calendar" />
            </LinearLayout>

            <!-- START TIME -->
            <TextView
                android:text="Start Time"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:textColor="#111827"
                android:fontFamily="@font/lexend_bold"/>

            <LinearLayout
                android:id="@+id/startTime"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/input_split"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/startText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:text="Select Start Time"
                    android:textColor="#111827"
                    android:textColorHint="#6B7280"
                    android:fontFamily="@font/lexend_regular"/>

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/input_icon_bg"
                    android:padding="12dp"
                    android:src="@drawable/ic_clock"/>
            </LinearLayout>

            <!-- END TIME -->
            <TextView
                android:text="End Time"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:textColor="#111827"
                android:fontFamily="@font/lexend_bold"/>

            <LinearLayout
                android:id="@+id/endTime"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/input_split"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/endText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:text="Select End Time"
                    android:textColor="#111827"
                    android:textColorHint="#6B7280"
                    android:fontFamily="@font/lexend_regular"/>

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/input_icon_bg"
                    android:padding="12dp"
                    android:src="@drawable/ic_clock"/>
            </LinearLayout>

            <!-- PURPOSE -->
            <TextView
                android:text="Purpose of Reservation"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="20dp"
                android:textColor="#111827"
                android:fontFamily="@font/lexend_bold"/>

            <Spinner
                android:id="@+id/purposeSpinner"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/input_bg"
                android:fontFamily="@font/lexend_regular"/>

            <!-- ATTENDEES -->
            <LinearLayout
                android:id="@+id/attendeesLayout"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Number of Attendees"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp"
                    android:textColor="#111827"
                    android:fontFamily="@font/lexend_bold"/>

                <Spinner
                    android:id="@+id/attendeesSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/input_bg"
                    android:textColor="#111827"
                    android:textColorHint="#6B7280"
                    android:fontFamily="@font/lexend_regular"/>
            </LinearLayout>

            <!-- ROOM HEADER -->
            <LinearLayout
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Available Room Slots"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:textColor="#111827"
                    android:fontFamily="@font/lexend_bold"/>

                <Spinner
                    android:id="@+id/floorSpinner"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:backgroundTint="#F97316"
                    android:textColor="#111827"
                    android:textColorHint="#6B7280"
                    android:fontFamily="@font/lexend_regular"/>

            </LinearLayout>

            <!-- ROOM GRID -->
            <GridLayout
                android:id="@+id/roomGrid"
                android:columnCount="3"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- SUBMIT -->
            <Button
                android:id="@+id/submitBtn"
                android:text="Submit Request -->"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="#F97316"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/lexend_bold"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>