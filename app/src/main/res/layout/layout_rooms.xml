<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">
        <TextView
            android:text="Rooms"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/ink_900"
            android:fontFamily="@font/lexend_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:text="Browse classrooms and check availability."
            android:textSize="12sp"
            android:textColor="@color/ink_500"
            android:fontFamily="@font/lexend_regular"
            android:layout_marginTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- FILTER BAR (Refined Card) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:text="BUILDING"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/ink_400"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/lexend_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:layout_gravity="center_horizontal"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_alt">
                <Spinner
                    android:id="@+id/buildingSpinner"
                    android:layout_width="180dp"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="12dp"/>
            </androidx.cardview.widget.CardView>

            <!-- FLOOR CHIPS -->
            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_gravity="center_horizontal"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/floorContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"/>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="16dp"/>

            <!-- DATE/TIME/STATUS SUMMARY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/roomDateButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/neutral_badge_soft"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="2026-09-20"
                    android:textColor="@color/ink_700"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/lexend_bold"/>

                <TextView
                    android:id="@+id/roomTimeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/neutral_badge_soft"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="16:09 - 16:09"
                    android:textColor="@color/ink_700"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/lexend_bold"/>

                <TextView
                    android:id="@+id/roomStatusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/neutral_badge_soft"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="All Status"
                    android:textColor="@color/ink_700"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/lexend_bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/roomWatchCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/ink_500"
                    android:fontFamily="@font/lexend_regular"
                    android:text="0 watching"/>

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_danger"
                    android:visibility="gone"
                    android:id="@+id/filterDot"/>

                <TextView
                    android:id="@+id/clearRoomFiltersButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/brand_orange"
                    android:textStyle="bold"
                    android:fontFamily="@font/lexend_bold"
                    android:text="Clear Filters"
                    android:visibility="gone"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/roomsRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"
            android:clipToPadding="false"
            android:paddingBottom="80dp"/>

        <TextView
            android:id="@+id/roomsEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="No rooms found."
            android:textColor="@color/ink_400"
            android:fontFamily="@font/lexend_regular"
            android:visibility="gone"/>

        <!-- MOBILE-FRIENDLY FILTERS FAB -->
        <androidx.cardview.widget.CardView
            android:id="@+id/filtersFab"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="20dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/brand_orange">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:src="@drawable/ic_filter"
                app:tint="#FFFFFF"
                android:contentDescription="Filter"/>
        </androidx.cardview.widget.CardView>

    </RelativeLayout>

</LinearLayout>