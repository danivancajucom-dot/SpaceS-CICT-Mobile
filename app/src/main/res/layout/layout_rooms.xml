<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="16dp"
            android:background="@drawable/input_field_bg"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/ink_500" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Search rooms..."
                android:textSize="14sp"
                android:textColor="@color/ink_900"
                android:textColorHint="@color/ink_500"
                android:background="@android:color/transparent"
                android:paddingStart="10dp"
                android:fontFamily="@font/lexend_regular"/>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingBottom="12dp">

                <TextView android:id="@+id/tabAll" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="22dp" android:text="All" android:textColor="@color/brand_orange"
                    android:textSize="14sp" android:textStyle="bold" android:clickable="true" android:focusable="true"
                    android:fontFamily="@font/lexend_bold"/>

                <TextView android:id="@+id/tabAvailable" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="22dp" android:text="Available" android:textColor="@color/ink_500"
                    android:textSize="14sp" android:textStyle="bold" android:clickable="true" android:focusable="true"
                    android:fontFamily="@font/lexend_bold"/>

                <TextView android:id="@+id/tabOccupied" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="22dp" android:text="Occupied" android:textColor="@color/ink_500"
                    android:textSize="14sp" android:textStyle="bold" android:clickable="true" android:focusable="true"
                    android:fontFamily="@font/lexend_bold"/>

                <TextView android:id="@+id/tabMaintenance" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Maintenance" android:textColor="@color/ink_500"
                    android:textSize="14sp" android:textStyle="bold" android:clickable="true" android:focusable="true"
                    android:fontFamily="@font/lexend_bold"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/roomsRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false"/>

</LinearLayout>