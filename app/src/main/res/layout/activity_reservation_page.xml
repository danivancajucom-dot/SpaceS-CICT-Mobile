<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:id="@+id/topSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="My Reservations"
                android:textStyle="bold"
                android:textSize="25sp"
                android:textColor="@color/ink_900"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/lexend_bold"/>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingBottom="12dp">

                <TextView android:id="@+id/tabAll" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="All" android:textColor="@color/brand_orange" android:textSize="14sp" android:textStyle="bold"
                    android:layout_marginEnd="24dp" android:clickable="true" android:focusable="true" android:fontFamily="@font/lexend_bold"/>

                <TextView android:id="@+id/tabPending" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Pending" android:textColor="@color/ink_500" android:textSize="14sp" android:textStyle="bold"
                    android:layout_marginEnd="24dp" android:clickable="true" android:focusable="true" android:fontFamily="@font/lexend_bold"/>

                <TextView android:id="@+id/tabApproved" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Approved" android:textColor="@color/ink_500" android:textSize="14sp" android:textStyle="bold"
                    android:layout_marginEnd="24dp" android:clickable="true" android:focusable="true" android:fontFamily="@font/lexend_bold"/>

                <TextView android:id="@+id/tabDenied" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Denied" android:textColor="@color/ink_500" android:textSize="14sp" android:textStyle="bold"
                    android:layout_marginEnd="24dp" android:clickable="true" android:focusable="true" android:fontFamily="@font/lexend_bold"/>

                <TextView android:id="@+id/tabCancelled" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Cancelled" android:textColor="@color/ink_500" android:textSize="14sp" android:textStyle="bold"
                    android:clickable="true" android:focusable="true" android:fontFamily="@font/lexend_bold"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reservationRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="20dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topSection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.cardview.widget.CardView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="999dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/brand_orange"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/fabAddReservation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="18dp"
            android:src="@drawable/ic_add"
            app:tint="#FFFFFF"
            android:clickable="true"
            android:focusable="true"/>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>