<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- TITLE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reservation Status"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:layout_marginStart="32dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/lexend_bold"/>

    <!-- FILTERS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textColor="#F97316"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingBottom="14dp"
                android:layout_marginEnd="50dp"
                android:background="@drawable/filter_active"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/lexend_bold"/>

            <TextView
                android:id="@+id/tabPending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textColor="#64748B"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingBottom="14dp"
                android:layout_marginEnd="50dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/lexend_bold"/>

            <TextView
                android:id="@+id/tabApproved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Approved"
                android:textColor="#64748B"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingBottom="14dp"
                android:layout_marginEnd="50dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/lexend_bold"/>

            <TextView
                android:id="@+id/tabDenied"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Denied"
                android:textColor="#64748B"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/lexend_bold"/>

        </LinearLayout>

    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D6DCE5"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"/>

        <!-- RESERVATION LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/reservationRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"/>

    </LinearLayout>

    <!-- FLOATING ADD BUTTON -->
    <FrameLayout
        android:id="@+id/fabAddReservation"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:layout_gravity="end"
        android:layout_margin="24dp"
        android:background="@drawable/fab_bg"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_add"
            android:contentDescription="Add Reservation"/>

    </FrameLayout>

</LinearLayout>