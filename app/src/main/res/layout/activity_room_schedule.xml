<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:paddingHorizontal="16dp"
        android:background="@color/surface"
        android:elevation="1dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_back"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/roomNameHeader"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="17sp"
            android:textColor="@color/ink_900"
            android:layout_centerInParent="true"
            android:fontFamily="@font/lexend_bold"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/surface">

        <ImageView android:id="@+id/weekPrevBtn" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_back" app:tint="@color/ink_700" android:clickable="true" android:focusable="true" xmlns:app="http://schemas.android.com/apk/res-auto"/>
        <TextView android:id="@+id/weekLabelText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/ink_900" android:fontFamily="@font/lexend_bold"/>
        <ImageView android:id="@+id/weekNextBtn" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_back" android:scaleX="-1" android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <!-- HEADER ROW: fixed left corner + scrollable day labels, synced with grid below -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface">

        <View
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@color/surface_alt"/>

        <HorizontalScrollView
            android:id="@+id/headerScroll"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/dayHeaderRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp"/>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- CONTENT: time column (fixed) + grid (scrolls both directions, synced with header) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:id="@+id/timeColumnScroll"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/timeColumn"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_alt"/>
        </ScrollView>

        <HorizontalScrollView
            android:id="@+id/contentHScroll"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">

            <ScrollView
                android:id="@+id/contentVScroll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/gridCanvas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_page"/>
            </ScrollView>
        </HorizontalScrollView>

    </LinearLayout>

</LinearLayout>