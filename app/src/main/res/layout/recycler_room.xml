<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Room Icon -->
        <androidx.cardview.widget.CardView
            android:id="@+id/roomIconCard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_alt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/ic_room"
                app:tint="@color/brand_orange"
                android:contentDescription="@string/room_icon" />
        </androidx.cardview.widget.CardView>

        <!-- Status Badge -->
        <androidx.cardview.widget.CardView
            android:id="@+id/statusBadgeCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/success"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lexend_bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="AVAILABLE" />
        </androidx.cardview.widget.CardView>

        <!-- Room Info -->
        <TextView
            android:id="@+id/roomName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/lexend_bold"
            android:textColor="@color/ink_900"
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/statusBadgeCard"
            app:layout_constraintStart_toEndOf="@+id/roomIconCard"
            app:layout_constraintTop_toTopOf="@+id/roomIconCard"
            tools:text="Loading Room..." />

        <TextView
            android:id="@+id/roomTypeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend_regular"
            android:textColor="@color/ink_500"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@+id/statusBadgeCard"
            app:layout_constraintStart_toStartOf="@+id/roomName"
            app:layout_constraintTop_toBottomOf="@+id/roomName"
            tools:text="Loading Room..." />

        <!-- Capacity and Floor -->
        <LinearLayout
            android:id="@+id/detailsLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/roomIconCard">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_capacity"
                app:tint="@color/brand_orange"
                android:contentDescription="@string/capacity_icon" />

            <TextView
                android:id="@+id/capacityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/lexend_bold"
                android:textColor="@color/ink_700"
                android:textSize="12sp"
                tools:text="Capacity" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_room"
                app:tint="@color/brand_orange"
                android:contentDescription="@string/location_icon" />

            <TextView
                android:id="@+id/floorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/lexend_bold"
                android:textColor="@color/ink_700"
                android:textSize="12sp"
                tools:text="Building · Floor " />
        </LinearLayout>

        <!-- Feature Tags -->
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/tagsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:flexWrap="wrap"
            app:layout_constraintTop_toBottomOf="@+id/detailsLayout">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/orange_chip_bg"
                android:fontFamily="@font/lexend_regular"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="❅ AC"
                android:textColor="@color/brand_orange"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/orange_chip_bg"
                android:fontFamily="@font/lexend_regular"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="📺 TV Display"
                android:textColor="@color/brand_orange"
                android:textSize="12sp" />
        </com.google.android.flexbox.FlexboxLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/divider"
            app:layout_constraintTop_toBottomOf="@+id/tagsLayout" />

        <!-- Bottom Actions -->
        <ImageView
            android:id="@+id/statusIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_check"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            app:tint="@color/brand_orange"
            android:contentDescription="@string/status_icon" />

        <TextView
            android:id="@+id/timeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/lexend_bold"
            android:textColor="@color/ink_900"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/statusIcon"
            app:layout_constraintEnd_toStartOf="@+id/viewScheduleButton"
            app:layout_constraintStart_toEndOf="@+id/statusIcon"
            app:layout_constraintTop_toTopOf="@+id/statusIcon"
            tools:text="Available Now" />

        <TextView
            android:id="@+id/viewScheduleButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/input_field_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/lexend_bold"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/schedule"
            android:textColor="@color/ink_700"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/reserveButton"
            app:layout_constraintEnd_toStartOf="@+id/reserveButton"
            app:layout_constraintTop_toTopOf="@+id/reserveButton" />

        <TextView
            android:id="@+id/reserveButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/orange_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/lexend_bold"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="@string/reserve"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider" />

        <TextView
            android:id="@+id/watchButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/orange_chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/lexend_bold"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/watch"
            android:textColor="@color/brand_orange"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/viewScheduleButton"
            app:layout_constraintEnd_toStartOf="@+id/viewScheduleButton"
            app:layout_constraintTop_toTopOf="@+id/viewScheduleButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
